## Illustrative values only. Use a reachable database hostname from the container.
## Do not use localhost here for a database running on the host.
DATABASE_URL=postgresql://count_timer_app:change-me@host.docker.internal:5432/count_timer
APP_ORIGIN=https://timer.example.com

# Local integration tests only. The test runner refuses any database without an _test suffix.
TEST_DATABASE_URL=postgresql://count_timer_test:test_password@127.0.0.1:55432/count_timer_test
